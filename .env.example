# Copy to .env.local and adapt to your machine.

# Factorio binary path used by scripts/test-factorio.sh
FACTORIO_PATH="/mnt/c/Program Files/Factorio/bin/x64/factorio.exe"

# Optional: player-data.json used by fmtk for mod portal auth.
# Example Windows path:
# FACTORIO_PLAYER_DATA="/mnt/c/Users/<you>/AppData/Roaming/Factorio/player-data.json"
